<?xml version="1.0" encoding="UTF-8"?>
<!--
  Connect IQ manifest for the "Cheer Squad" data field.

  IMPORTANT #1: the `id` below is a placeholder UUID generated for this
  scaffold. When you open this project in the Connect IQ SDK (VS Code
  Monkey C extension), regenerate a fresh one for your own app via the
  SDK's "New Project" flow, or just run `uuidgen` and paste the result
  here. Any valid UUID works for sideloading to your own watch; you only
  need a *registered* one if you ever publish to the Connect IQ Store.
  Whatever you land on, copy the SAME value into ios-app's Config.swift.

  IMPORTANT #2: <iq:background/> below is my best-effort guess at the
  element the SDK generates for enabling a background service — I could
  not verify its exact syntax against live docs while writing this. Don't
  hand-edit around it: open this file in the VS Code Monkey C extension's
  visual manifest editor and use its "Background Service" toggle for this
  app instead — it'll write the correct element for whatever SDK version
  you have, replacing my guess below if it differs.

  Your watch (Forerunner 935) reports Connect IQ API level 3.1 — quite
  old (2017). That's why the source code avoids Application.Storage
  (added in 3.4.0) in favor of Background.exit()/onBackgroundData() for
  getting messages from the background service to the visible field.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="CheerApp"
        id="d4d1e0d2-8f2b-4c1a-9c2e-1a2b3c4d5e6f"
        launcherIcon="@Drawables.LauncherIcon"
        name="@Strings.AppName"
        type="datafield"
        version="1.0.0">
        <iq:products>
            <iq:product id="fr935"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Background"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
