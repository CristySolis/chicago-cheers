platform :ios, '16.0'

target 'CheerRelay' do
  use_frameworks!
  pod 'ConnectIQ'

  # The tests run inside the app, so they only need to find its libraries.
  target 'CheerRelayTests' do
    inherit! :search_paths
  end
end

# The ConnectIQ podspec declares iOS 12.0, below the 15.0 floor Xcode 27 accepts.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    end
  end
end
