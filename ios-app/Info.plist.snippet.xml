<!--
  Merge these keys into your Xcode project's generated Info.plist
  (or paste into the Info tab of the target's settings).
-->
<key>CFBundleURLTypes</key>
<array>
    <dict>
        <key>CFBundleURLSchemes</key>
        <array>
            <string>cheersquad</string>
        </array>
    </dict>
</array>

<!-- Lets iOS confirm Garmin Connect Mobile is installed before handing off to it. -->
<key>LSApplicationQueriesSchemes</key>
<array>
    <string>gcm-ciq</string>
    <string>gcm-ciq3</string>
</array>

<!-- Keeps polling alive a bit longer if the app is backgrounded during the race. -->
<key>UIBackgroundModes</key>
<array>
    <string>fetch</string>
</array>
